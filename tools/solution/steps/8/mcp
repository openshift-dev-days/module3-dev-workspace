#!/bin/bash

# MCP Server Management Script
# Manages Node.js and Camel MCP servers

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NODE_SERVER_DIR="$SCRIPT_DIR/mcp-servers/node-js"
CAMEL_SERVER_DIR="$SCRIPT_DIR/mcp-servers/camel"
CAMEL_PROCESS_NAME="mcp-camel"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

function log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

function log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

function log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

function check_nodejs_installed() {
    if ! command -v node &> /dev/null; then
        log_error "Node.js is not installed"
        exit 1
    fi
}

function check_camel_installed() {
    if ! command -v camel &> /dev/null; then
        log_error "Camel CLI is not installed"
        exit 1
    fi
}

# ===== Node.js Server Functions =====

function get_node_pid() {
    for pid in $(pgrep -f "node.*index.js"); do
        local cwd=$(pwdx $pid 2>/dev/null | awk '{print $2}')
        if [ "$cwd" == "$NODE_SERVER_DIR" ]; then
            echo $pid
            return
        fi
    done
}

function is_node_running() {
    local pid=$(get_node_pid)
    [ -n "$pid" ]
}

function start_node() {
    log_info "${BLUE}[Node.js]${NC} Starting MCP server..."

    if is_node_running; then
        local existing_pid=$(get_node_pid)
        log_warn "${BLUE}[Node.js]${NC} Server is already running (PID: $existing_pid)"
        return 0
    fi

    check_nodejs_installed

    pushd "$NODE_SERVER_DIR" > /dev/null || {
        log_error "${BLUE}[Node.js]${NC} Cannot access server directory: $NODE_SERVER_DIR"
        exit 1
    }

    if [ ! -d "node_modules" ]; then
        log_info "${BLUE}[Node.js]${NC} Installing dependencies..."
        npm install > /dev/null 2>&1
        if [ $? -ne 0 ]; then
            log_error "${BLUE}[Node.js]${NC} npm install failed"
            exit 1
        fi
    fi

    log_info "${BLUE}[Node.js]${NC} Starting server..."
    nohup npm start > "$NODE_SERVER_DIR/server.log" 2>&1 &

    sleep 3

    popd > /dev/null

    if is_node_running; then
        local pid=$(get_node_pid)
        log_info "${BLUE}[Node.js]${NC} Server started (PID: $pid)"
        local port=$(grep "^server.port=" "$NODE_SERVER_DIR/application.properties" 2>/dev/null | cut -d'=' -f2)
        log_info "${BLUE}[Node.js]${NC} Endpoint: http://localhost:${port:-9090}/mcp"
    else
        log_error "${BLUE}[Node.js]${NC} Failed to start. Check: $NODE_SERVER_DIR/server.log"
        exit 1
    fi
}

function stop_node() {
    log_info "${BLUE}[Node.js]${NC} Stopping MCP server..."

    local pid=$(get_node_pid)

    if [ -z "$pid" ]; then
        log_warn "${BLUE}[Node.js]${NC} Server is not running"
        return 0
    fi

    log_info "${BLUE}[Node.js]${NC} Stopping server (PID: $pid)..."
    pkill -P $pid 2>/dev/null
    kill $pid 2>/dev/null

    local waited=0
    while [ $waited -lt 10 ]; do
        if ! is_node_running; then
            break
        fi
        sleep 1
        waited=$((waited + 1))
    done

    if is_node_running; then
        log_warn "${BLUE}[Node.js]${NC} Forcing shutdown..."
        kill -9 $pid 2>/dev/null
        sleep 1
    fi

    if is_node_running; then
        log_error "${BLUE}[Node.js]${NC} Failed to stop server"
        exit 1
    else
        log_info "${BLUE}[Node.js]${NC} Server stopped"
    fi
}

function status_node() {
    local pid=$(get_node_pid)

    if [ -n "$pid" ]; then
        log_info "${BLUE}[Node.js]${NC} Server is ${GREEN}RUNNING${NC} (PID: $pid)"
        local port=$(grep "^server.port=" "$NODE_SERVER_DIR/application.properties" 2>/dev/null | cut -d'=' -f2)
        log_info "${BLUE}[Node.js]${NC} Endpoint: http://localhost:${port:-9090}/mcp"
    else
        log_warn "${BLUE}[Node.js]${NC} Server is ${RED}NOT RUNNING${NC}"
    fi
}

function logs_node() {
    local log_file="$NODE_SERVER_DIR/server.log"
    if [ ! -f "$log_file" ]; then
        log_warn "${BLUE}[Node.js]${NC} Log file not found"
        return 1
    fi

    if [ "$1" == "-f" ]; then
        tail -f "$log_file"
    else
        tail -n 50 "$log_file"
    fi
}

# ===== Camel Server Functions =====

function is_camel_running() {
    camel ps 2>/dev/null | grep -q "$CAMEL_PROCESS_NAME"
}

function start_camel() {
    log_info "${YELLOW}[Camel]${NC} Starting MCP server..."

    if is_camel_running; then
        log_warn "${YELLOW}[Camel]${NC} Server is already running"
        return 0
    fi

    check_camel_installed

    if [ ! -d "$CAMEL_SERVER_DIR" ]; then
        log_error "${YELLOW}[Camel]${NC} Cannot access server directory: $CAMEL_SERVER_DIR"
        exit 1
    fi

    log_info "${YELLOW}[Camel]${NC} Starting Camel MCP server..."
    camel run "$CAMEL_SERVER_DIR" --dep org.apache.camel:camel-xslt-saxon:4.22.0 --background --name "$CAMEL_PROCESS_NAME"

    sleep 3

    if is_camel_running; then
        log_info "${YELLOW}[Camel]${NC} Server started"
        log_info "${YELLOW}[Camel]${NC} Endpoint: http://localhost:9091/mcp"
    else
        log_error "${YELLOW}[Camel]${NC} Failed to start. Check: camel logs --name $CAMEL_PROCESS_NAME"
        exit 1
    fi
}

function stop_camel() {
    log_info "${YELLOW}[Camel]${NC} Stopping MCP server..."

    if ! is_camel_running; then
        log_warn "${YELLOW}[Camel]${NC} Server is not running"
        return 0
    fi

    camel stop "$CAMEL_PROCESS_NAME" 2>/dev/null

    sleep 2

    if is_camel_running; then
        log_error "${YELLOW}[Camel]${NC} Failed to stop server"
        exit 1
    else
        log_info "${YELLOW}[Camel]${NC} Server stopped"
    fi
}

function status_camel() {
    if is_camel_running; then
        log_info "${YELLOW}[Camel]${NC} Server is ${GREEN}RUNNING${NC}"
        log_info "${YELLOW}[Camel]${NC} Endpoint: http://localhost:9091/mcp"
    else
        log_warn "${YELLOW}[Camel]${NC} Server is ${RED}NOT RUNNING${NC}"
    fi
}

function logs_camel() {
    if [ "$1" == "-f" ]; then
        camel log "$CAMEL_PROCESS_NAME" --follow
    else
        camel log "$CAMEL_PROCESS_NAME" --tail 50
    fi
}

# ===== Combined Functions =====

function start() {
    local server="${1:-all}"
    case "$server" in
        node|nodejs)
            start_node
            ;;
        camel)
            start_camel
            ;;
        all)
            start_node
            echo ""
            start_camel
            ;;
        *)
            log_error "Unknown server: $server. Use 'node', 'camel', or 'all'"
            exit 1
            ;;
    esac
}

function stop() {
    local server="${1:-all}"
    case "$server" in
        node|nodejs)
            stop_node
            ;;
        camel)
            stop_camel
            ;;
        all)
            stop_node
            echo ""
            stop_camel
            ;;
        *)
            log_error "Unknown server: $server. Use 'node', 'camel', or 'all'"
            exit 1
            ;;
    esac
}

function restart() {
    local server="${1:-all}"
    stop "$server"
    sleep 2
    start "$server"
}

function status() {
    local server="${1:-all}"
    case "$server" in
        node|nodejs)
            status_node
            ;;
        camel)
            status_camel
            ;;
        all)
            log_info "Checking MCP servers status..."
            echo ""
            status_node
            echo ""
            status_camel
            ;;
        *)
            log_error "Unknown server: $server. Use 'node', 'camel', or 'all'"
            exit 1
            ;;
    esac
}

function logs() {
    local server="$1"
    local follow="$2"

    case "$server" in
        node|nodejs)
            logs_node "$follow"
            ;;
        camel)
            logs_camel "$follow"
            ;;
        *)
            log_error "Please specify server: 'node' or 'camel'"
            exit 1
            ;;
    esac
}

function usage() {
    cat << EOF
MCP Server Management Script

Usage: $0 <command> [server] [options]

Commands:
    start [server]      Start MCP server(s)
    stop [server]       Stop MCP server(s)
    restart [server]    Restart MCP server(s)
    status [server]     Check server status
    logs <server> [-f]  Show server logs
    help                Show this help message

Servers:
    node, nodejs        Node.js MCP server (port 9090)
    camel              Camel MCP server (port 9091)
    all                Both servers (default)

Options:
    -f, --follow       Follow logs in real-time (use with logs command)

Examples:
    $0 start              # Start both servers
    $0 start node         # Start only Node.js server
    $0 status             # Check status of both servers
    $0 logs camel -f      # Follow Camel logs
    $0 stop all           # Stop both servers

EOF
}

# Main script
case "${1:-}" in
    start)
        start "${2:-all}"
        ;;
    stop)
        stop "${2:-all}"
        ;;
    restart)
        restart "${2:-all}"
        ;;
    status)
        status "${2:-all}"
        ;;
    logs)
        if [ -z "$2" ]; then
            log_error "Please specify which server logs to view: 'node' or 'camel'"
            exit 1
        fi
        logs "$2" "$3"
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        log_error "Unknown command: ${1:-}"
        echo ""
        usage
        exit 1
        ;;
esac
